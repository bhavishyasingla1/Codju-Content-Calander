{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/content/sync",
      "destination": "/api/content/sync"
    },
    {
      "source": "/api/content/batch",
      "destination": "/api/content/batch"
    },
    {
      "source": "/api/content/:id",
      "destination": "/api/content/[id]"
    },
    {
      "source": "/api/content",
      "destination": "/api/content"
    },
    {
      "source": "/api/notes",
      "destination": "/api/notes"
    },
    {
      "source": "/api/generate-ai",
      "destination": "/api/generate-ai"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
